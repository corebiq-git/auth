rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function activeUser() { return signedIn() && userDoc().data.status == 'active'; }
    function sameCompany(companyId) { return activeUser() && userDoc().data.companyId == companyId; }
    function role(roleName) { return activeUser() && userDoc().data.role == roleName; }
    function admin() { return role('admin'); }
    function manager() { return admin() || role('manager'); }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow create: if admin();
      allow update: if admin() || (request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','phone','photoURL','updatedAt']));
      allow delete: if admin();
    }

    match /companies/{companyId} {
      allow read: if sameCompany(companyId);
      allow create: if admin() && request.resource.id == userDoc().data.companyId;
      allow update: if admin();
      allow delete: if false;
    }

    match /{collection}/{docId} {
      allow read: if activeUser() && sameCompany(resource.data.companyId);
      allow create: if activeUser() && sameCompany(request.resource.data.companyId) && (manager() || role('sales') || role('operations') || role('finance') || role('visa'));
      allow update: if activeUser() && sameCompany(resource.data.companyId) && sameCompany(request.resource.data.companyId) && (manager() || role('sales') || role('operations') || role('finance') || role('visa'));
      allow delete: if manager();
    }
  }
}
